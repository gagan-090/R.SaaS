# Restaurant SaaS — environment variables.
# Copy to .env.local (never commit it) or run: bash infra/scripts/gen-dev-secrets.sh
# Values here are placeholders only. NEVER put a real secret in this file.

# ---------- Runtime ----------
# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000

# ---------- Database ----------
# Password of the Postgres superuser/owner inside docker compose (dev only)
POSTGRES_PASSWORD=change-me
# Password for the least-privilege app role `rsaas_app` (no UPDATE/DELETE on audit_events, RLS applies)
APP_DB_PASSWORD=change-me
# Connection the API uses at runtime — MUST be the rsaas_app role so RLS is enforced
DATABASE_URL=postgresql://rsaas_app:change-me@localhost:5433/rsaas?schema=public
# Connection used only by `prisma migrate` and seed — the owner role
MIGRATION_DATABASE_URL=postgresql://rsaas_owner:change-me@localhost:5433/rsaas?schema=public

# ---------- Auth ----------
# HMAC secret for 15-minute access JWTs (min 32 chars, random)
JWT_ACCESS_SECRET=
# HMAC secret for refresh/step-up/MFA-challenge tokens (min 32 chars, random, different from access)
JWT_REFRESH_SECRET=
# 32 random bytes, base64 — AES-256-GCM key that encrypts TOTP secrets at rest
MFA_ENCRYPTION_KEY=

# ---------- Licensing (Ed25519) ----------
# PKCS#8 DER private key, base64, one line. Cloud only — never ship to hubs/clients
LICENSE_SIGNING_PRIVATE_KEY=
# SPKI DER public key, base64, one line. Shipped to hubs to verify tokens offline
LICENSE_PUBLIC_KEY=

# ---------- Bootstrap ----------
# First Super Admin created by `prisma db seed` (change the password on first login)
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ---------- HTTP ----------
# Comma-separated list of allowed browser origins for the admin portal
CORS_ORIGINS=http://localhost:8080
# Public base URL of the API (used in verification-email links)
PUBLIC_API_URL=http://localhost:3000

# ---------- Email (optional in dev: links are logged to console when SMTP_HOST is empty) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Restaurant SaaS <no-reply@example.com>"

# ---------- Object storage (S3-compatible; optional until menu images land) ----------
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Monitoring (optional) ----------
SENTRY_DSN_API=
# Flutter apps read this at build time: --dart-define=SENTRY_DSN_FLUTTER=...
SENTRY_DSN_FLUTTER=

# ---------- Flutter build-time ----------
# Passed with --dart-define=API_BASE_URL=... when building pos_app / admin_web
API_BASE_URL=http://localhost:3000/api/v1
