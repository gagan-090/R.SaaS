// Restaurant SaaS — cloud schema (Phase 1 + Phase 2 entities).
// Conventions: ids are UUIDv7; money is integer paise (Int); times are UTC (timestamptz).
// Every restaurant-scoped table carries tenant_id; branch-scoped tables also carry branch_id.
// Row-level security policies live in prisma/migrations/*_rls/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- platform

enum AdminStatus {
  invited
  active
  disabled
  deleted // removed by housekeeping: cannot sign in, email freed, kept for the audit trail
}

model PlatformAdmin {
  id               String              @id @default(uuid(7)) @db.Uuid
  email            String              @unique
  name             String
  passwordHash     String?             @map("password_hash")
  mfaEnabled       Boolean             @default(true) @map("mfa_enabled")
  status           AdminStatus         @default(invited)
  failedLoginCount Int                 @default(0) @map("failed_login_count")
  lockedUntil      DateTime?           @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?           @map("last_login_at") @db.Timestamptz(3)
  inviteTokenHash  String?             @unique @map("invite_token_hash")
  inviteExpiresAt  DateTime?           @map("invite_expires_at") @db.Timestamptz(3)
  invitedById      String?             @map("invited_by_id") @db.Uuid
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles            PlatformAdminRole[]
  mfa              MFAEnrollment?      @relation("AdminMfa")

  @@map("platform_admins")
}

model PlatformRole {
  id          String              @id @default(uuid(7)) @db.Uuid
  name        String              @unique
  description String?
  permissions String[] // Permission.key values (tier = platform)
  isSystem    Boolean             @default(false) @map("is_system")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  admins      PlatformAdminRole[]

  @@map("platform_roles")
}

model PlatformAdminRole {
  adminId    String        @map("admin_id") @db.Uuid
  roleId     String        @map("role_id") @db.Uuid
  assignedBy String?       @map("assigned_by") @db.Uuid
  assignedAt DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(3)
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role       PlatformRole  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([adminId, roleId])
  @@map("platform_admin_roles")
}

enum PermissionTier {
  platform
  restaurant
}

model Permission {
  key         String         @id
  description String
  tier        PermissionTier

  @@map("permissions")
}

model MFAEnrollment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  adminId             String?        @unique @map("admin_id") @db.Uuid
  userId              String?        @unique @map("user_id") @db.Uuid
  totpSecretEncrypted String         @map("totp_secret_encrypted")
  recoveryCodeHashes  String[]       @map("recovery_code_hashes")
  enrolledAt          DateTime?      @map("enrolled_at") @db.Timestamptz(3) // null until confirmed
  lastUsedStep        Int?           @map("last_used_step") // replay guard for TOTP
  resetById           String?        @map("reset_by") @db.Uuid
  resetAt             DateTime?      @map("reset_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  admin               PlatformAdmin? @relation("AdminMfa", fields: [adminId], references: [id], onDelete: Cascade)
  user                User?          @relation("UserMfa", fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_enrollments")
}

enum SubjectType {
  admin
  user
}

model RefreshToken {
  id          String      @id @default(uuid(7)) @db.Uuid
  subjectType SubjectType @map("subject_type")
  subjectId   String      @map("subject_id") @db.Uuid
  familyId    String      @map("family_id") @db.Uuid
  tokenHash   String      @unique @map("token_hash")
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(3)
  replacedBy  String?     @map("replaced_by") @db.Uuid
  userAgent   String?     @map("user_agent")
  ip          String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  recipient String // email address or admin id
  type      String // e.g. mfa_reset, email_verification
  payload   Json
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("notifications")
}

// ---------------------------------------------------------------- plans & tenants

enum BillingCycle {
  monthly
  yearly
}

model SubscriptionPlan {
  id               String       @id @default(uuid(7)) @db.Uuid
  code             String       @unique // standard | professional | premium
  name             String
  featureFlags     String[]     @map("feature_flags")
  limits           Json
  pricePaise       Int          @map("price_paise") // monthly price
  yearlyPricePaise Int          @default(0) @map("yearly_price_paise") // yearly price (customers choose either)
  tier             Int          @default(100) // display / upgrade order: Standard 1 < Professional 2 < Premium 3
  billingCycle     BillingCycle @default(monthly) @map("billing_cycle") // default cycle offered first
  archived         Boolean      @default(false) // hidden from new sales; existing licenses keep working
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  licenses         License[]

  @@map("subscription_plans")
}

/// Lifecycle: pending (created) → active ⇄ suspended ⇄ archived → deleted. "blocked" is a legacy hard stop.
enum TenantStatus {
  pending
  active
  suspended
  blocked
  archived
  deleted
}

// Registration before the owner's email is verified. Not tenant-scoped (no tenant exists yet).
model RestaurantRegistration {
  id             String       @id @default(uuid(7)) @db.Uuid
  ownerEmail     String       @map("owner_email")
  billingCycle   BillingCycle @default(monthly) @map("billing_cycle") // what the owner will pay: monthly or yearly
  ownerName      String       @map("owner_name")
  restaurantName String       @map("restaurant_name")
  gstin          String?
  address        String?
  planCode       String       @map("plan_code")
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  verifiedAt     DateTime?    @map("verified_at") @db.Timestamptz(3)
  tenantId       String?      @map("tenant_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?      @map("cancel_reason")
  lastSentAt     DateTime?    @map("last_sent_at") @db.Timestamptz(3)
  sendCount      Int          @default(1) @map("send_count")
  lastEmailError String?      @map("last_email_error")

  @@index([ownerEmail])
  @@map("restaurant_registrations")
}

model RestaurantTenant {
  id              String       @id @default(uuid(7)) @db.Uuid
  code            String       @unique // e.g. R000123
  name            String
  ownerEmail      String       @unique @map("owner_email")
  gstin           String?
  address         String?
  status          TenantStatus @default(pending)
  statusReason    String?      @map("status_reason")
  statusChangedAt DateTime?    @map("status_changed_at") @db.Timestamptz(3)
  menuVersion     Int          @default(0) @map("menu_version")
  branding        Json? // plan feature "branding": { color, logoImageId, textSize, headingWeight, headingCase }
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  franchises      Franchise[]
  branches        Branch[]
  licenses        License[]
  users           User[]
  media           Media[]
  customRoles     CustomRole[]

  @@map("restaurant_tenants")
}

model Franchise {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  name           String
  billingContact String?          @map("billing_contact")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         RestaurantTenant @relation(fields: [tenantId], references: [id])
  branches       Branch[]

  @@index([tenantId])
  @@map("franchises")
}

model Branch {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  franchiseId String?          @map("franchise_id") @db.Uuid
  code        String // e.g. BR01 — used in invoice numbers
  name        String
  address     String?
  gstin       String?
  settings    Json             @default("{}")
  seq         BigInt           @default(0) // config cursor (set by trigger)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      RestaurantTenant @relation(fields: [tenantId], references: [id])
  franchise   Franchise?       @relation(fields: [franchiseId], references: [id])

  @@unique([tenantId, code])
  @@map("branches")
}

enum LicenseStatus {
  active
  revoked
  superseded
}

model License {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  planId       String           @map("plan_id") @db.Uuid
  startsAt     DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime         @map("ends_at") @db.Timestamptz(3)
  graceDays    Int              @default(7) @map("grace_days")
  status       LicenseStatus    @default(active)
  billingCycle BillingCycle     @default(monthly) @map("billing_cycle") // what the customer bought
  amountPaise  Int              @default(0) @map("amount_paise") // price of that cycle at purchase
  signedToken  String           @map("signed_token")
  issuedBy     String           @map("issued_by") @db.Uuid
  reason       String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       RestaurantTenant @relation(fields: [tenantId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  payments     PaymentRecord[]

  @@index([tenantId, status])
  @@map("licenses")
}

model PaymentRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  licenseId   String?  @map("license_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  method      String // bank | upi | cash | other
  reference   String?
  paidAt      DateTime @map("paid_at") @db.Timestamptz(3)
  recordedBy  String   @map("recorded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  license     License? @relation(fields: [licenseId], references: [id])

  @@index([tenantId])
  @@map("payment_records")
}

// ---------------------------------------------------------------- people & devices

enum UserStatus {
  active
  disabled
}

enum RestaurantRole {
  owner
  it_admin
  cashier
  waiter
  chef
  auditor
  custom // permissions come from custom_roles (plan feature "roles.custom")
}

model User {
  id               String               @id @default(uuid(7)) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  name             String
  email            String?              @unique
  phone            String?
  passwordHash     String?              @map("password_hash")
  pinHash          String?              @map("pin_hash")
  status           UserStatus           @default(active)
  webAccess        Boolean              @default(false) @map("web_access") // may sign in to the web portal (email + PIN)
  pinSetAt         DateTime?            @map("pin_set_at") @db.Timestamptz(3)
  failedLoginCount Int                  @default(0) @map("failed_login_count")
  lockedUntil      DateTime?            @map("locked_until") @db.Timestamptz(3)
  seq              BigInt               @default(0)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           RestaurantTenant     @relation(fields: [tenantId], references: [id])
  roles            UserRoleAssignment[]
  pinTokens        PinToken[]
  mfa              MFAEnrollment?       @relation("UserMfa")

  @@index([tenantId])
  @@map("users")
}

model UserRoleAssignment {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  role             RestaurantRole
  branchIds        String[]       @map("branch_ids") @db.Uuid // empty = all branches
  extraPermissions String[]       @map("extra_permissions")
  customRoleId     String?        @map("custom_role_id") @db.Uuid
  seq              BigInt         @default(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole       CustomRole?    @relation(fields: [customRoleId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@index([tenantId])
  @@map("user_role_assignments")
}

/// Owner-defined role: a name and a set of restaurant permissions (never more than its creator holds).
model CustomRole {
  id          String               @id @default(uuid(7)) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  name        String
  description String?
  permissions String[]
  deleted     Boolean              @default(false)
  seq         BigInt               @default(0)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments UserRoleAssignment[]
  tenant      RestaurantTenant     @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("custom_roles")
}

/// One-time link for an employee to set (invite) or reset their PIN. Only the SHA-256 of the token is stored.
model PinToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  purpose   String // invite | reset
  createdBy String?   @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("pin_tokens")
}

enum DevicePlatform {
  windows
  android
  web
}

model Device {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  name            String
  platform        DevicePlatform
  isHub           Boolean        @default(false) @map("is_hub")
  deviceTokenHash String         @unique @map("device_token_hash")
  pairedAt        DateTime       @default(now()) @map("paired_at") @db.Timestamptz(3)
  lastSeenAt      DateTime?      @map("last_seen_at") @db.Timestamptz(3)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)

  @@index([tenantId, branchId])
  @@map("devices")
}

// ---------------------------------------------------------------- layout & menu (cloud is writer)

model Floor {
  id            String  @id @default(uuid(7)) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  name          String
  sortOrder     Int     @default(0) @map("sort_order")
  width         Int     @default(1200) // layout canvas size in layout units (1 unit ≈ 1 cm)
  height        Int     @default(800)
  layoutVersion Int     @default(1) @map("layout_version") // optimistic lock for the floor editor
  seq           BigInt  @default(0)
  deleted       Boolean @default(false)
  tables        Table[]

  @@index([tenantId, branchId])
  @@map("floors")
}

model Table {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  floorId  String  @map("floor_id") @db.Uuid
  name     String // number or name, e.g. "12"
  seats    Int     @default(4)
  layoutX  Int     @default(0) @map("layout_x") // legacy grid position (older hubs)
  layoutY  Int     @default(0) @map("layout_y")
  shape    String  @default("square") // round | square | rect
  posX     Int     @default(0) @map("pos_x") // centre on the floor canvas, layout units
  posY     Int     @default(0) @map("pos_y")
  width    Int     @default(80)
  height   Int     @default(80)
  rotation Int     @default(0) // degrees, 0–359
  chairs   Json? // [{ x, y, rotation }] relative to the table centre; null = arranged from seats
  status   String  @default("available") // manual: available | reserved | unavailable (occupied comes from orders)
  seq      BigInt  @default(0)
  deleted  Boolean @default(false)
  floor    Floor   @relation(fields: [floorId], references: [id])

  @@unique([branchId, name])
  @@index([tenantId, branchId])
  @@map("tables")
}

model TaxRule {
  id       String     @id @default(uuid(7)) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  name     String // e.g. "GST 5%"
  rateBp   Int        @map("rate_bp") // basis points: 500 = 5% (split equally into CGST + SGST)
  seq      BigInt     @default(0)
  deleted  Boolean    @default(false)
  items    MenuItem[]

  @@index([tenantId])
  @@map("tax_rules")
}

model MenuCategory {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  branchId  String?    @map("branch_id") @db.Uuid // null = tenant-wide
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  active    Boolean    @default(true) // inactive categories are hidden from ordering but keep their items
  seq       BigInt     @default(0)
  deleted   Boolean    @default(false)
  items     MenuItem[]

  @@index([tenantId])
  @@map("menu_categories")
}

model MenuItem {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  code        String // stable item code (Excel imports match on it, never on the name)
  name        String
  description String?
  active      Boolean       @default(true)
  unit        String        @default("plate")
  quantity    Int           @default(1)
  pricePaise  Int           @map("price_paise") // = the default variant's price (kept for older hubs)
  taxRuleId   String        @map("tax_rule_id") @db.Uuid
  available   Boolean       @default(true)
  isVeg       Boolean       @default(true) @map("is_veg")
  imageId     String?       @map("image_id") @db.Uuid
  plateColors Json?         @map("plate_colors") // { base, sauce, garnish } for the PlateIcon
  seq         BigInt        @default(0)
  deleted     Boolean       @default(false)
  category    MenuCategory  @relation(fields: [categoryId], references: [id])
  taxRule     TaxRule       @relation(fields: [taxRuleId], references: [id])
  variants    MenuVariant[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("menu_items")
}

/// A separately priced size or portion of a menu item (Cola 500 ml, Biryani Half plate). Serving quantity, portion
/// ratio, cost price and selling price are distinct: the ratio is only a default for recipes, never for prices.
model MenuVariant {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  itemId          String       @map("item_id") @db.Uuid
  code            String // stable variant code / SKU, unique in the restaurant and never reused
  name            String // what staff and guests see: "500 ml", "Half plate"
  portionLabel    String?      @map("portion_label") // quarter | half | full | custom text
  servingQuantity Decimal?     @map("serving_quantity") @db.Decimal(12, 3) // how much is served, e.g. 500
  servingUnit     String?      @map("serving_unit") // ml, l, g, kg, piece, plate, bottle …
  portionRatio    Decimal?     @map("portion_ratio") @db.Decimal(6, 3) // default recipe scale vs the full portion
  pricePaise      Int          @map("price_paise") // selling price
  costPricePaise  Int?         @map("cost_price_paise") // optional manual cost; recipes give the computed cost
  taxRuleId       String?      @map("tax_rule_id") @db.Uuid // null = the item's tax rule
  available       Boolean      @default(true)
  isDefault       Boolean      @default(false) @map("is_default")
  sortOrder       Int          @default(0) @map("sort_order")
  seq             BigInt       @default(0)
  deleted         Boolean      @default(false)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  item            MenuItem     @relation(fields: [itemId], references: [id])
  recipeLines     RecipeLine[]

  @@unique([tenantId, code])
  @@index([tenantId, itemId])
  @@map("menu_variants")
}

// ---------------------------------------------------------------- live operations (hub is writer; cloud stores synced copies)

enum OrderType {
  dine_in
  takeaway
}

enum OrderStatus {
  open
  billed
  paid
  cancelled
}

model Order {
  id       String      @id @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  branchId String      @map("branch_id") @db.Uuid
  type     OrderType
  tableId  String?     @map("table_id") @db.Uuid
  waiterId String?     @map("waiter_id") @db.Uuid
  status   OrderStatus
  openedBy String      @map("opened_by") @db.Uuid
  openedAt DateTime    @map("opened_at") @db.Timestamptz(3)
  version  Int
  lines    OrderLine[]

  @@index([tenantId, branchId])
  @@map("orders")
}

enum OrderLineStatus {
  pending
  sent
  reversed
}

model OrderLine {
  id                 String          @id @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  branchId           String          @map("branch_id") @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  menuItemId         String          @map("menu_item_id") @db.Uuid
  nameSnapshot       String          @map("name_snapshot")
  priceSnapshotPaise Int             @map("price_snapshot_paise")
  taxRateSnapshotBp  Int             @map("tax_rate_snapshot_bp")
  qty                Int
  notes              String?
  status             OrderLineStatus
  sentAt             DateTime?       @map("sent_at") @db.Timestamptz(3)
  order              Order           @relation(fields: [orderId], references: [id])

  @@index([tenantId, branchId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actor      String   @db.Uuid
  at         DateTime @db.Timestamptz(3)

  @@index([tenantId, branchId])
  @@map("order_status_history")
}

model TableTransfer {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  fromTableId String   @map("from_table_id") @db.Uuid
  toTableId   String   @map("to_table_id") @db.Uuid
  actor       String   @db.Uuid
  at          DateTime @db.Timestamptz(3)

  @@index([tenantId, branchId])
  @@map("table_transfers")
}

enum BillStatus {
  open
  paid
}

model Bill {
  id            String     @id @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  branchId      String     @map("branch_id") @db.Uuid
  orderId       String     @map("order_id") @db.Uuid
  invoiceNo     String     @map("invoice_no")
  subtotalPaise Int        @map("subtotal_paise")
  discountPaise Int        @map("discount_paise")
  cgstPaise     Int        @map("cgst_paise")
  sgstPaise     Int        @map("sgst_paise")
  tipPaise      Int        @map("tip_paise")
  roundOffPaise Int        @map("round_off_paise")
  totalPaise    Int        @map("total_paise")
  status        BillStatus
  closedAt      DateTime?  @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime   @map("created_at") @db.Timestamptz(3)

  @@unique([branchId, invoiceNo])
  @@index([tenantId, branchId])
  @@map("bills")
}

model BillAdjustment {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  billId      String   @map("bill_id") @db.Uuid
  type        String // reversal | correction
  amountPaise Int      @map("amount_paise") // signed: negative reduces the bill
  reason      String
  approvedBy  String?  @map("approved_by") @db.Uuid
  actor       String   @db.Uuid
  at          DateTime @db.Timestamptz(3)

  @@index([tenantId, branchId])
  @@map("bill_adjustments")
}

enum PaymentMode {
  cash
  upi
  card
}

model Payment {
  id             String      @id @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  billId         String      @map("bill_id") @db.Uuid
  mode           PaymentMode
  amountPaise    Int         @map("amount_paise")
  tenderedPaise  Int?        @map("tendered_paise")
  reference      String?
  idempotencyKey String      @map("idempotency_key")
  at             DateTime    @db.Timestamptz(3)

  @@unique([branchId, idempotencyKey])
  @@index([tenantId, branchId])
  @@map("payments")
}

model TipAllocation {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  branchId    String @map("branch_id") @db.Uuid
  billId      String @map("bill_id") @db.Uuid
  waiterId    String @map("waiter_id") @db.Uuid
  amountPaise Int    @map("amount_paise")

  @@index([tenantId, branchId])
  @@map("tip_allocations")
}

// ---------------------------------------------------------------- audit & sync

model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid // null = platform-level event
  branchId   String?  @map("branch_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String?  @map("actor_type") // admin | user | device | system
  actorRole  String?  @map("actor_role") // role(s) at the time of the action
  actorName  String?  @map("actor_name") // name at the time (later renames do not rewrite history)
  requestId  String?  @map("request_id") // ties together everything one request changed
  action     String
  objectType String?  @map("object_type")
  objectId   String?  @map("object_id")
  before     Json?
  after      Json?
  reason     String?
  deviceId   String?  @map("device_id")
  sessionId  String?  @map("session_id")
  ip         String?
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, at])
  @@index([action])
  @@index([tenantId, actorId])
  @@map("audit_events")
}

// Cloud-side ingest log of hub outbox events. event_id is the hub's UUIDv7; unique = exactly-once storage.
model SyncEvent {
  eventId    String   @id @map("event_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  entity     String
  entityId   String   @map("entity_id")
  op         String
  payload    Json
  createdAt  DateTime @map("created_at") @db.Timestamptz(3) // when the hub created it
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([tenantId, branchId])
  @@map("sync_events")
}

model SyncConflict {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  eventId    String   @unique @map("event_id") @db.Uuid
  reason     String
  payload    Json
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(3)
  resolvedBy String?  @map("resolved_by") @db.Uuid
  resolution String?

  @@index([tenantId, branchId])
  @@map("sync_conflicts")
}

/// Menu photo bytes (resized by the console before upload). Served publicly by unguessable id at GET /media/:id.
model Media {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  contentType String           @map("content_type")
  bytes       Bytes
  sizeBytes   Int              @map("size_bytes")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      RestaurantTenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("media")
}

// ---------------------------------------------------------------- inventory (plan feature "inventory")

/// Where stock is kept (Dry store, Walk-in cooler, Bar).
model InventoryLocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, name])
  @@map("inventory_locations")
}

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  gstin     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, name])
  @@map("suppliers")
}

/// A stock item. Quantities live in the base unit; the purchase unit converts with conversionFactor
/// (1 purchase unit = conversionFactor base units). Current stock is never stored here — it is the sum of the ledger.
model InventoryProduct {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  sku               String
  name              String
  category          String?
  baseUnit          String   @map("base_unit")
  purchaseUnit      String   @map("purchase_unit")
  conversionFactor  Decimal  @map("conversion_factor") @db.Decimal(14, 4)
  unitCostPaise     Int      @default(0) @map("unit_cost_paise") // last / list cost per purchase unit
  avgCostPaise      Decimal  @default(0) @map("avg_cost_paise") @db.Decimal(18, 6) // moving average per base unit
  minStock          Decimal  @default(0) @map("min_stock") @db.Decimal(14, 3) // reorder level, base units
  defaultSupplierId String?  @map("default_supplier_id") @db.Uuid
  defaultLocationId String?  @map("default_location_id") @db.Uuid
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  movements   StockMovement[]
  recipeLines RecipeLine[]
  requests    ReplenishmentRequest[]

  @@unique([tenantId, sku])
  @@map("inventory_products")
}

enum StockMovementType {
  opening
  purchase
  sale
  consumption
  wastage
  return_to_supplier
  customer_return
  count_adjustment
  adjustment
  transfer_out
  transfer_in
}

/// Append-only stock ledger. Quantity is signed and in the product's base unit; value is signed integer paise at the
/// cost used for that movement. Retries are absorbed by idempotencyKey; sales by (sourceType, sourceId, productId).
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  locationId     String?           @map("location_id") @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(14, 3)
  enteredQty     Decimal           @map("entered_qty") @db.Decimal(14, 3)
  enteredUnit    String            @map("entered_unit")
  valuePaise     Int               @map("value_paise")
  unitCostPaise  Decimal?          @map("unit_cost_paise") @db.Decimal(18, 6) // per base unit
  supplierId     String?           @map("supplier_id") @db.Uuid
  reference      String? // supplier invoice / document number
  batchNumber    String?           @map("batch_number")
  expiryDate     DateTime?         @map("expiry_date") @db.Date
  reason         String?
  sourceType     String?           @map("source_type") // bill_line | import | manual
  sourceId       String?           @map("source_id")
  idempotencyKey String?           @map("idempotency_key")
  actorId        String?           @map("actor_id") @db.Uuid
  actorRole      String?           @map("actor_role")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, sourceType, sourceId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

/// What one sold unit of a menu variant consumes. Quantities are per variant (a half plate need not be half).
model RecipeLine {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @db.Decimal(14, 3)
  unit      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  variant MenuVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([variantId, productId])
  @@index([tenantId])
  @@map("recipe_lines")
}

/// Kitchen asks for more stock; Admin/Owner orders and receives it.
model ReplenishmentRequest {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @db.Decimal(14, 3)
  unit        String
  note        String?
  status      String   @default("requested") // requested | ordered | received | cancelled
  requestedBy String   @map("requested_by") @db.Uuid
  handledBy   String?  @map("handled_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("replenishment_requests")
}

/// Restaurant expenses (rent, utilities, repairs, non-stock purchases). Never deleted: a mistake is voided with a reason.
model Expense {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  category    String
  description String
  amountPaise Int       @map("amount_paise")
  paidOn      DateTime  @map("paid_on") @db.Date
  paymentMode String    @map("payment_mode") // cash | upi | card | bank | other
  supplierId  String?   @map("supplier_id") @db.Uuid
  reference   String?
  createdBy   String    @map("created_by") @db.Uuid
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy    String?   @map("voided_by") @db.Uuid
  voidReason  String?   @map("void_reason")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, paidOn])
  @@map("expenses")
}

/// One Excel import: file metadata, what validation found, the parsed plan to commit, and the outcome.
model ImportJob {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  kind        String // menu | inventory
  mode        String // create | update
  fileName    String    @map("file_name")
  fileSize    Int       @map("file_size")
  fileSha256  String    @map("file_sha256")
  status      String // validated | invalid | committed | partially_committed
  counts      Json
  errors      Json
  plan        Json // parsed rows, so commit never re-reads the file
  result      Json?
  actorId     String    @map("actor_id") @db.Uuid
  actorRole   String?   @map("actor_role")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt DateTime? @map("committed_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("import_jobs")
}

/// A verified copy of a restaurant's logs in cold storage, made when it is archived (checked again on restore).
model RestaurantArchive {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  storage    String // driver: file | s3
  storageKey String    @map("storage_key")
  sha256     String
  sizeBytes  Int       @map("size_bytes")
  counts     Json
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  restoredAt DateTime? @map("restored_at") @db.Timestamptz(3)
  restoredBy String?   @map("restored_by") @db.Uuid

  @@index([tenantId])
  @@map("restaurant_archives")
}

/// A verified cold-storage copy of audit events older than the retention period (18 months).
model AuditArchive {
  id         String   @id @default(uuid(7)) @db.Uuid
  before     DateTime @db.Timestamptz(3) // every archived event happened before this
  storage    String
  storageKey String   @map("storage_key")
  sha256     String
  sizeBytes  Int      @map("size_bytes")
  count      Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("audit_archives")
}
