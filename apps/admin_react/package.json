{
  "name": "@rsaas/admin-react",
  "private": true,
  "version": "0.1.0",
  "description": "BhojMitra web console (Super Admin + Restaurant console) in React — same API and flows as apps/admin_web.",
  "type": "module",
  "scripts": {
