<?xml version="1.0" encoding="utf-8"?>
<!-- The hub LAN API is HTTPS with a self-signed certificate that the app pins by fingerprint (not by CA),
     so the system trust store is unchanged. Plain HTTP is allowed only so a development/LAN cloud API
     (e.g. http://192.168.x.x:3000) works; production API_BASE_URL must be https:// (see DECISIONS.md). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
